#!/usr/bin/env bash
# Thali Code — an AI coding agent for your terminal, wired to Thali.
#
#   thali            run the coding agent
#   thali sync       refresh the model list from Thali's live catalog
#
# Runs the Thali Code engine (branded OpenCode), compiled to a standalone binary.
set -euo pipefail

ENGINE_DIR="${THALI_ENGINE_DIR:-$HOME/.thali-code/engine}"
SYNC_SCRIPT="${THALI_SYNC_SCRIPT:-$HOME/.local/bin/thali-sync.mjs}"
export PATH="$HOME/.bun/bin:$PATH"

if [ "${1:-}" = "sync" ]; then
  command -v node >/dev/null 2>&1 || { echo "Model sync needs Node.js 18+."; exit 1; }
  exec node "$SYNC_SCRIPT"
fi

if [ -z "${THALI_API_KEY:-}" ]; then
  echo "Set your Thali API key first:  export THALI_API_KEY=thali-sk-…"
  echo "Get one — 1,000,000 free tokens — at https://thaliai.in"
  exit 1
fi

BIN=$(ls "$ENGINE_DIR/packages/opencode/dist"/opencode-*/bin/opencode 2>/dev/null | head -1)
if [ -z "$BIN" ] || [ ! -x "$BIN" ]; then
  echo "Thali Code isn't built yet. Re-run the installer:"
  echo "  curl -fsSL https://raw.githubusercontent.com/thaliai/thali-code/main/install.sh | bash"
  exit 1
fi

exec "$BIN" "$@"
